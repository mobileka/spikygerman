{
  "$schema": "https://design-tokens.org/format/latest",
  "name": "SpikyGerman Design System",
  "version": "1.0.0",
  "description": "Machine-readable export of the canonical Kumo binding layer found inline in index.html, was-ist-das.html, artikel-und-verben.html, sich-vorstellen.html, einkaufen.html, dialoge.html, summary.html and preise.html. Values are frozen literals; _design_system/tokens/tokens.css is the rendering source of truth and adds two optional levers (radiusScale, spaceScale) with identity defaults.",
  "meta": {
    "product": "SpikyGerman",
    "surface": "iPhone-framed learning screens, lang=\"ru\", 390×844 css px",
    "themes": ["light", "dark"],
    "themeAttribute": "data-theme on <html>",
    "themeStorageKey": "spiky-theme",
    "canonicalSource": "index.html",
    "driftedScreens": ["einstellungen.html"]
  },
  "font": {
    "display": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "body": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
  },
  "type": {
    "scale": {
      "xs": "12px",
      "sm": "13px",
      "base": "14px",
      "lg": "16px",
      "xl": "20px",
      "2xl": "24px",
      "3xl": "30px"
    },
    "leading": { "body": 1.5, "tight": 1.2 },
    "tracking": { "display": 0 },
    "weight": { "label": 500, "title": 600, "display": 700 }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "12": "48px"
  },
  "radius": {
    "sm": "4px", "md": "6px", "lg": "8px", "pill": "9999px"
  },
  "elevation": {
    "flat": "none",
    "ring": "0 0 0 1px var(--border)",
    "raised": "0 1px 2px 0 rgba(0, 0, 0, .08)",
    "raisedDark": "0 1px 3px 0 rgba(0, 0, 0, .55)"
  },
  "focus": {
    "ring": "0 0 0 4px rgba(37, 99, 235, .22)",
    "ringDark": "0 0 0 4px oklch(0.700 0.160 264 / .4)"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "ease": "cubic-bezier(0.77, 0, 0.175, 1)"
  },
  "layout": {
    "odGap": "8px",
    "odRailPad": "16px",
    "appPad": "16px",
    "tabCount": 3,
    "statStripCols": 4
  },
  "device": {
    "screenWidth": "390px",
    "screenHeight": "844px",
    "bezel": "10px",
    "outerRadius": "52px",
    "screenRadius": "42px",
    "safeTop": "50px",
    "safeBottom": "29px",
    "systemFg": { "light": "#17181a", "dark": "oklch(0.950 0.005 264)" },
    "screenBg": { "light": "#f8f8f9", "dark": "oklch(0.115 0.012 264)" },
    "stageBg": { "light": "#eaebee", "dark": "oklch(0.135 0.014 264)" }
  },
  "color": {
    "light": {
      "bg": "#f5f8ff",
      "surface": "#ffffff",
      "surfaceWarm": "#eaf1ff",
      "paper": "#ffffff",
      "fg": "#101828",
      "fg2": "#344054",
      "muted": "#667085",
      "meta": "#2563eb",
      "border": "#d7e0ef",
      "borderSoft": "#edf2f8",
      "accent": "#2563eb",
      "accentOn": "#ffffff",
      "accentHover": "color-mix(in oklab, #2563eb, black 8%)",
      "accentActive": "color-mix(in oklab, #2563eb, black 14%)",
      "success": "#16a34a",
      "warn": "#f59e0b",
      "danger": "#ef4444",
      "successInk": "#15803d",
      "warnInk": "#b45309",
      "dangerInk": "#b91c1c",
      "dangerSolid": "#dc2626",
      "dangerInkSolid": "#ffffff",
      "codeBg": "rgba(0, 0, 0, .05)",
      "stageGlow": "rgba(255, 255, 255, .94)",
      "phoneBody": "#1f2530"
    },
    "dark": {
      "bg": "oklch(0.207 0.021 264)",
      "surface": "oklch(0.262 0.024 264)",
      "surfaceWarm": "oklch(0.322 0.030 264)",
      "paper": "oklch(0.235 0.024 264)",
      "fg": "oklch(0.965 0.006 264)",
      "fg2": "oklch(0.860 0.012 264)",
      "muted": "oklch(0.720 0.020 264)",
      "meta": "oklch(0.720 0.140 264)",
      "border": "oklch(0.372 0.028 264)",
      "borderSoft": "oklch(0.308 0.022 264)",
      "accent": "oklch(0.700 0.160 264)",
      "accentOn": "oklch(0.170 0.020 264)",
      "accentHover": "color-mix(in oklab, oklch(0.700 0.160 264), white 8%)",
      "accentActive": "color-mix(in oklab, oklch(0.700 0.160 264), white 14%)",
      "success": "oklch(0.760 0.160 152)",
      "warn": "oklch(0.820 0.150 78)",
      "danger": "oklch(0.710 0.180 25)",
      "successInk": "color-mix(in oklab, oklch(0.760 0.160 152), white 10%)",
      "warnInk": "color-mix(in oklab, oklch(0.820 0.150 78), white 10%)",
      "dangerInk": "color-mix(in oklab, oklch(0.710 0.180 25), white 10%)",
      "dangerSolid": "oklch(0.710 0.180 25)",
      "dangerInkSolid": "oklch(0.170 0.020 264)",
      "codeBg": "rgba(255, 255, 255, .09)",
      "stageGlow": "oklch(0.620 0.170 264 / .16)",
      "phoneBody": "#0a0d13"
    }
  },
  "components": {
    "button": {
      "padding": "10px 14px",
      "radius": "var(--radius-lg)",
      "fontSize": "var(--text-base)",
      "weight": 600,
      "minHeight": "44px"
    },
    "sectionLink": {
      "padding": "14px 16px",
      "radius": "var(--radius-lg)",
      "gap": "14px",
      "elevation": "ring + raised"
    },
    "qcard": { "padding": "20px", "radius": "var(--radius-lg)", "elevation": "ring + raised" },
    "choice": { "padding": "12px 16px", "radius": "var(--radius-lg)", "minHeight": "44px" },
    "tabbar": { "height": "64px", "radius": "var(--radius-lg)", "tabRadius": "var(--radius-md)", "iconSize": "20px" },
    "badge": { "padding": "2px 8px", "radius": "var(--radius-pill)", "fontSize": "var(--text-xs)" },
    "progressSegmented": {
      "variant": ".progress-line.is-segmented",
      "segments": [".progress-seg.seg-correct", ".progress-seg.seg-almost", ".progress-seg.seg-incorrect"],
      "segmentOrder": ["correct", "almost", "incorrect"],
      "segmentColors": ["var(--success)", "var(--warn)", "var(--danger)"],
      "track": "var(--surface-warm)",
      "empty": "track shows through",
      "widths": "inline % of total"
    },
    "sectionRing": {
      "variant": ".sec-n:has(.sec-ring) > .sec-ring",
      "viewBox": "0 0 56 56",
      "radius": 24,
      "strokeWidth": 3.5,
      "track": "var(--surface-warm)",
      "segments": [".ring-correct", ".ring-almost", ".ring-incorrect"],
      "segmentOrder": ["correct", "almost", "incorrect"]
    }
  }
}
